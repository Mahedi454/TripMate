# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# These are public identifiers, safe to ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# Locally: your-project-id.firebaseapp.com. On the live site: the site's own domain
# (e.g. trippilot-alpha.vercel.app), so Google sign-in runs through next.config.ts rewrites.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# TripPilot Express API (backend/). Used to save users in MongoDB.
NEXT_PUBLIC_API_URL=http://localhost:5000
