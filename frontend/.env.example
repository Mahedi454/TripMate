# Supabase project settings -> API
# Supabase dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API -> anon public key
# Safe to ship to the browser. Every request it makes is subject to row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase dashboard -> Project Settings -> API -> service_role key
# SERVER ONLY. Bypasses row level security entirely. Never prefix this with
# NEXT_PUBLIC_ and never import it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# TripMate Express API (backend/). Used to save users in MongoDB.
NEXT_PUBLIC_API_URL=http://localhost:5000
