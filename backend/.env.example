PORT=5000
NODE_ENV=development

# Local MongoDB (or an Atlas SRV string)
MONGODB_URI=mongodb://127.0.0.1:27017/tripmate

# Supabase dashboard -> Project Settings -> API. Server side only, never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Comma separated emails that become admin on their next sign-in
ADMIN_EMAILS=you@example.com
