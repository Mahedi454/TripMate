PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/trippilot locally)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/trippilot?appName=TripPilot

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON. Never commit real values.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Comma separated emails that become admin on their next sign-in
ADMIN_EMAILS=you@example.com
